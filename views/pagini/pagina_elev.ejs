<!DOCTYPE html>
<html lang="ro">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/pagina_elev.css">
    <title>My Mathematics Website</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&display=swap" rel="stylesheet">

    <!-- <link rel="stylesheet" href="style.css"> -->
</head>

<body>

    <header>
        <picture>
            <img src="/imagini/logo/Logo simplu negru.png" alt="Logo">
        </picture>
        <h1><%= salut %></h1>
    </header>

    <div id="content">
        <hr>
        <h2 class="teme">Teme</h2>
        <% for (const date in alldata.capitole["MISC"]["Teme"]) { %>
            <% if (date.startsWith("@@@")) { %>
                <% continue; %>
            <% } %>
            <p class="data_tema_zi">
                <%= date %>: <%= alldata.capitole["MISC"]["Teme"][date] %>
            </p>
        <% } %>

        <!-- <h2 class="atentie">Atentie</h2>
        <% for (const date in alldata.capitole["MISC"]["Atentie"]) { %>
            <p class="data_atentie_zi">
                <%= date %>: <%= alldata.capitole["MISC"]["Atentie"][date] %>
            </p>
        <% } %> -->
        <% for (const nume_capitol of Object.keys(alldata.capitole)) { %>
                <% continut_capitol = alldata.capitole[nume_capitol]; %>
                <% if (nume_capitol.startsWith("@@@") || nume_capitol === "MISC" || continut_capitol["@@@ultima_evaluare"] === Date.parse("03 Aug 2005")) { %>
                    <% continue; %>
                <% } %>
                <hr>
                <h2 class="capitol"><%= nume_capitol %>
                    <% if (
                        continut_capitol["@@@medie"] !== undefined &&
                        continut_capitol["@@@medie"] !== 0
                    ) { %>
                        <small class="medie-capitol">
                            (
                                <%= Number.isInteger(continut_capitol["@@@medie"])
                                    ? continut_capitol["@@@medie"]
                                    : continut_capitol["@@@medie"].toFixed(1) %>
                            )
                        </small>
                    <% } %>
                </h2>

                <% for (const nume_subcapitol of Object.keys(continut_capitol)) { %>
                    <% continut_subcapitol = continut_capitol[nume_subcapitol]; %>
                    <% if (nume_subcapitol.startsWith("@@@") || continut_subcapitol["@@@ultima_evaluare"] === Date.parse("04 May 2005")) { %>
                        <% continue; %>
                    <% } %>
                    <h3 class="subcapitol"><%= nume_subcapitol %>
                        <% if (continut_subcapitol["@@@nota_subcapitol"] !== 0) { %>
                            <small class="nota-subcapitol">
                                <%= continut_subcapitol["@@@nota_subcapitol"] %>
                            </small>
                        <% } %>
                    </h3>
                    <% for (const date of Object.keys(continut_subcapitol)) { %>
                        <% if (date.startsWith("@@@")) { %>
                            <% continue; %>
                        <% } %>
                        <p class="data-si-nota-zi">
                            <%= date %>: <%= continut_subcapitol[date] %>
                        </p>
                    <% } %>
                <% } %>
        <% } %>
    </div>

</body>

</html>